  "cards": [
    {
      "dot": "amber",
      "title": "One matcher thread",
      "items": [
        "Only one thread ever touches the book, so the output order depends only on the input order"
      ]
    },
    {
      "dot": "emerald",
      "title": "Rings without locks",
      "items": [
        "Fixed slots, no memory requests, nothing to wait on"
      ]
    },
    {
      "dot": "cyan",
      "title": "Checked two ways",
      "items": [
        "The output hash is the same on every run",
        "Depth snapshots are compared with Binance's own"
      ]
    }
